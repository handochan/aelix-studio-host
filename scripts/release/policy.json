{
  "schema": "aelix-studio-host.release-policy/1",
  "repository": "handochan/aelix-studio-host",
  "upstream": {
    "repository": "iOfficeAI/AionCore",
    "tag": "v0.2.2",
    "commit": "47e66d0d151123e973b3fd1e77afcb5671b3f8c5"
  },
  "binary": "aioncore",
  "package": "aionui-app",
  "targets": {
    "darwin-arm64": {
      "rustTarget": "aarch64-apple-darwin"
    },
    "darwin-x64": {
      "rustTarget": "x86_64-apple-darwin"
    },
    "linux-arm64": {
      "rustTarget": "aarch64-unknown-linux-gnu",
      "container": "linux/arm64",
      "glibcMax": "GLIBC_2.30"
    },
    "linux-x64": {
      "rustTarget": "x86_64-unknown-linux-gnu",
      "container": "linux/amd64",
      "glibcMax": "GLIBC_2.34"
    },
    "win32-x64": {
      "rustTarget": "x86_64-pc-windows-msvc",
      "rustFlags": "-C target-feature=+crt-static"
    }
  }
}
